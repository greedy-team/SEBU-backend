# Production EC2 only. Create a fresh DB and application user on its private Docker network.
# After Flyway initializes the schema, stop the app and restore a verified development
# catalogue snapshot with catalog_transfer.py before opening the service to users.
# Initial migration seeds alone do not contain the complete development catalogue.
# Fill the blank secrets on that server. Do not copy development passwords or JWT secrets.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://sebu-prod-mysql:3306/sebu_prod?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Seoul
DB_USERNAME=sebu_prod_app
DB_PASSWORD=
JWT_SECRET_BASE64=
APP_AUTH_CSRF_ALLOWEDORIGINS=https://sebu.kr,https://www.sebu.kr
APP_AUTH_COOKIE_SECURE=true
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m
# Generate a distinct JWT secret from at least 32 random bytes for each environment.
# Optional monitoring: use prod,monitoring and a separate random MONITORING_TOKEN.
