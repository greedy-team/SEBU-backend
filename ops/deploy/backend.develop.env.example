# Development EC2 only. Both servers use prod for MySQL/HTTPS; local includes test data.
# Set the existing development DB credentials locally; never commit backend.env.
# At production cutover, allow only the development FE origin(s) here.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://sebu-mysql:3306/sebu?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Seoul
DB_USERNAME=sebu_dev_app
DB_PASSWORD=
JWT_SECRET_BASE64=
APP_AUTH_CSRF_ALLOWEDORIGINS=https://sebu-frontend.vercel.app
APP_AUTH_COOKIE_SECURE=true
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m
# Generate a distinct JWT secret from at least 32 random bytes for each environment.
# Optional monitoring: use prod,monitoring and a separate random MONITORING_TOKEN.
